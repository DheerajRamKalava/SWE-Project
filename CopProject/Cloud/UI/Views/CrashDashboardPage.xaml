<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Cloud.UI.Views.CrashDashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Cloud.Crash.ViewModels">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Crash reports" Style="{StaticResource TitleTextBlockStyle}" />
            <ProgressRing Grid.Column="1" Width="24" Height="24" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            <Button Grid.Column="2" Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" />
        </Grid>

        <InfoBar Grid.Row="1" Severity="Error" Title="Error" IsClosable="False"
                 IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

        <InfoBar Grid.Row="2" Severity="Warning" IsClosable="False"
                 IsOpen="{x:Bind ViewModel.HasPending, Mode=OneWay}"
                 Message="{x:Bind ViewModel.PendingMessage, Mode=OneWay}">
            <InfoBar.ActionButton>
                <Button Content="Retry upload" Command="{x:Bind ViewModel.RetryPendingCommand}" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Border Grid.Row="3" Padding="16" CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox PlaceholderText="Search type, frame, message or fingerprint"
                         Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox Grid.Column="1" Header="Category" HorizontalAlignment="Stretch"
                          ItemsSource="{x:Bind ViewModel.CategoryOptions}"
                          SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}" />
                <ComboBox Grid.Column="2" Header="Module" HorizontalAlignment="Stretch"
                          ItemsSource="{x:Bind ViewModel.ModuleOptions, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedModule, Mode=TwoWay}" />
                <Button Grid.Column="3" Content="Clear" VerticalAlignment="Bottom"
                        Command="{x:Bind ViewModel.ClearFiltersCommand}" />
            </Grid>
        </Border>

        <Grid Grid.Row="4" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Padding="12,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*" />
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Exception" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="Category" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Text="Module" FontWeight="SemiBold" />
                <TextBlock Grid.Column="3" Text="Count" FontWeight="SemiBold" />
                <TextBlock Grid.Column="4" Text="Last seen" FontWeight="SemiBold" />
            </Grid>
            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Groups}" SelectionMode="None"
                      IsItemClickEnabled="True" ItemClick="Group_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:CrashGroupItem">
                        <Grid Padding="0,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Bind ShortExceptionType}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind TopFrame}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind CategoryText}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Module}" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Count}" />
                            <TextBlock Grid.Column="4" Text="{x:Bind LastSeenText}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Grid.Row="1" Text="No crashes match." HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
        </Grid>
    </Grid>
</Page>
